# Copy to .env.production on the box (NOT committed to git) and fill in real
# values. Container-to-container hostnames (certyfi-postgres) resolve via
# apps-network — same pattern as the other apps on muthu-linux.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__Default=Host=certyfi-postgres;Port=5432;Database=certyfi;Username=certyfi;Password=REPLACE_ME_SAME_AS_POSTGRES_PASSWORD

Jwt__SigningKey=REPLACE_ME_GENERATE_WITH_openssl_rand_-base64_48
Jwt__Issuer=certyfi-platform
Jwt__Audience=certyfi-clients
Jwt__AccessTokenMinutes=30

Cors__AllowedOrigins__0=https://certyfi.ahamsys.com

# Required — the API refuses to start without it. Encrypts each tenant's
# signing private key at rest. Generate once with `openssl rand -base64 32`
# and back it up: losing it makes existing signing keys unusable.
Kms__LocalMasterKey=REPLACE_ME_GENERATE_WITH_openssl_rand_-base64_32

# Public site URL, used to build the verificationUrl the Partner API returns.
PublicApp__BaseUrl=https://certyfi.ahamsys.com

# Email (student notifications), sent through Resend. The From address must
# be on a domain verified in Resend. Leave Email__Provider=None to queue
# nothing out (emails are recorded as Skipped).
Email__Provider=Resend
Email__From=Certyfi <no-reply@REPLACE_ME_VERIFIED_DOMAIN>
Email__Resend__ApiKey=REPLACE_ME_re_...
# Email__ReplyTo=support@ahamsys.com

# Partner API requests allowed per minute per API key (default 120).
Partner__RateLimitPerMinute=120

# Used only by the postgres container in compose.yaml (docker compose reads
# this same file's POSTGRES_PASSWORD if you pass --env-file, or export it
# separately — see DEPLOY.md step 2).
POSTGRES_PASSWORD=REPLACE_ME
