# TEST system settings (deploy/test/compose.yaml, on pwms-server). Secrets here are the
# test system's own: never production's, so nothing signed or issued on one
# works on the other. Keep this file private (chmod 600, not shared).

ASPNETCORE_ENVIRONMENT=Production
App__EnvironmentLabel=TEST SYSTEM

ConnectionStrings__Default=Host=certyfi-test-postgres;Port=5432;Database=certyfi;Username=certyfi;Password=fSlNvwNGv8i8DeKj-pZTZ7_5_i7YQslo
POSTGRES_PASSWORD=fSlNvwNGv8i8DeKj-pZTZ7_5_i7YQslo

Jwt__SigningKey=qzrdgThb80vQW9feo1uVP9tth1HqGVh+/DLbQoEuLK23YdZW4j7Qpw5EDhDKKo6J
Jwt__Issuer=certyfi-platform
Jwt__Audience=certyfi-clients
Jwt__AccessTokenMinutes=30
Kms__LocalMasterKey=rWzCRyIfFFL4lxqmALa8BvlPqkEn0f3mmS/2/SZ+wO0=

PublicApp__BaseUrl=https://certyfi.onnurendu.shop
Cors__AllowedOrigins__0=https://certyfi.onnurendu.shop

# Every email goes to the catch-all inbox (https://certyfi.onnurendu.shop/mail/).
Email__Provider=Smtp
Email__From=Certyfi TEST <no-reply@certyfi-test.local>
Email__Smtp__Host=certyfi-test-mailpit
Email__Smtp__Port=1025

# On the internet now: webhooks only to public https addresses, as in production.
Webhooks__AllowHttp=false
Webhooks__AllowPrivateAddresses=false

Partner__RateLimitPerMinute=120
